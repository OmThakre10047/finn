# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily (search) — https://tavily.com
TAVILY_API_KEY=

# LLM router — model IDs ONLY here, never in code.
# Run scripts/list_models.py with GEMINI_API_KEY set to see what your key can use.
# Prefer a flash-lite tier for LLM_CHEAP.
LLM_CHEAP=
LLM_STRONG=

# App
ALLOWED_ORIGINS=http://localhost:3000
DB_PATH=data/finn.db
SNAPSHOT_DIR=data/snapshots
FORCE_SNAPSHOT=0
PORT=8000
